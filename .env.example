# packages/api
PORT=3000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
RATE_LIMIT_PER_IP_PER_HOUR=5
REQUEST_TIMEOUT_MS=25000
# Global controls, independent of the per-IP limit above — defense against
# an attacker rotating through many source IPs to bypass a purely per-IP
# limit. GLOBAL_REQUESTS_PER_MINUTE caps total AI-calling throughput no
# matter how many distinct IPs are used. GLOBAL_TOKEN_BUDGET is a ROLLING
# per-hour cap (not a lifetime total), so exhausting it throttles for the
# rest of that hour and then recovers on its own — it never requires a
# manual restart to bring the AI feature back for other visitors. Leave
# GLOBAL_TOKEN_BUDGET empty for unlimited (not recommended in production).
GLOBAL_MAX_CONCURRENCY=3
GLOBAL_REQUESTS_PER_MINUTE=20
GLOBAL_TOKEN_BUDGET=300000
# Number of trusted proxy hops in front of this server (Fastify's
# `trustProxy` hop count). 0 = no proxy trusted (correct for local dev).
# Set this to match your real deployment platform's proxy hop count, or
# per-IP rate limiting either merges every client into one bucket or
# becomes spoofable via a forged X-Forwarded-For header.
TRUST_PROXY_HOPS=0
